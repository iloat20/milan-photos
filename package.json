{
  "name": "milan-photos",
  "private": true,
  "description": "米兰美术馆照片画廊 — 工程化（lint / e2e / Lighthouse CI）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "python tools/sync_photos.py",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"styles.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "lhci": "npm run build && npx lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.1"
  }
}
